// ============================================
// Prisma Schema — VetCare SaaS Multi-Tenant
// Supabase + PostgreSQL (Auth propio con JWT)
// Última actualización: 2026-07-18 (Post-Op Module Refactor)
// ============================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")      // Pooled connection (Supabase Pooler - port 6543)
  directUrl  = env("DIRECT_URL")          // Direct connection (Supabase Direct - port 5432)
  extensions = [pgcrypto, uuidOssp(map: "uuid-ossp")]
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  VET
  OWNER
}

enum TreatmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

/// Tipo de procedimiento — define el protocolo post-op y los signos de alarma a vigilar
enum ProcedureType {
  CASTRATION_MALE        // Orquiectomía
  OVARIOHYSTERECTOMY     // Ovariohisterectomía (OVH)
  ORTHOPEDIC_FRACTURE    // Cirugía ortopédica / fractura
  TUMOR_RESECTION        // Resección de tumor / masa
  DENTAL                 // Profilaxis dental / extracción
  GASTROENTEROLOGY       // Cirugía digestiva / cuerpo extraño
  OPHTHALMOLOGY          // Cirugía ocular
  DERMATOLOGY            // Cirugía de piel / heridas
  GENERAL_SURGERY        // Cirugía general
  MEDICAL_TREATMENT      // Tratamiento médico (sin cirugía)
  OTHER
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RODENT
  REPTILE
  OTHER
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

/// Tipo de registro de evolución: domiciliario (dueño) o clínico (veterinario en consulta)
enum DailyLogType {
  OWNER    // Registrado por el dueño desde casa
  CLINICAL // Registrado por el veterinario en consulta
  TECH     // Registrado por un auxiliar técnico
}

/// Estado de cada evento de medicación individual
enum MedicationLogStatus {
  PENDING  // Aún no ha llegado la hora
  GIVEN    // Medicamento administrado correctamente
  SKIPPED  // Dosis omitida (con razón)
  LATE     // Administrado fuera de la ventana horaria (> 2h de retraso)
}

/// Tipo de visita de control post-operatoria
enum ControlVisitType {
  HOURS_48        // Control a las 48 horas post-cirugía
  STITCH_REMOVAL  // Retiro de puntos (día 7–10)
  BANDAGE_CHANGE  // Cambio de vendaje
  ULTRASOUND      // Ecografía de seguimiento
  BLOOD_TEST      // Análisis de sangre de control
  GENERAL_CONTROL // Control general
  FINAL_DISCHARGE // Alta médica definitiva
  OTHER
}

enum ControlVisitStatus {
  SCHEDULED   // Programada
  COMPLETED   // Realizada
  CANCELLED   // Cancelada
  RESCHEDULED // Reprogramada
}

// ============================================
// TENANT: Clinica Veterinaria
// ============================================

model Clinic {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(200)
  slug      String       @unique @db.VarChar(100)
  logoUrl   String?     @map("logo_url")
  address   String?     @db.Text
  phone     String?     @db.VarChar(20)
  email     String      @db.VarChar(255)
  country   String?     @db.VarChar(3)
  currency  String      @default("CLP") @db.VarChar(3)
  timezone  String      @default("America/Santiago") @db.VarChar(50)
  status    ClinicStatus @default(TRIAL)
  settings  Json?
  maxVets   Int         @default(1) @db.SmallInt
  maxPets   Int         @default(50) @db.SmallInt
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  members      ClinicMember[]
  pets         Pet[]
  treatments   Treatment[]
  subscription Subscription?
  invitations  ClinicInvitation[]

  @@index([status])
  @@index([createdAt])
  @@map("clinics")
}

// ============================================
// MEMBRESIA: Usuario <-> Clinica
// ============================================

model ClinicMember {
  id       String   @id @default(uuid()) @db.Uuid
  clinicId String   @map("clinic_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     Role
  invitedBy String? @map("invited_by") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  isActive Boolean  @default(true) @map("is_active")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@index([role])
  @@map("clinic_members")
}

// ============================================
// INVITACIONES a la Clinica
// ============================================

model ClinicInvitation {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  email      String   @db.VarChar(255)
  role       Role
  token      String   @unique @db.VarChar(255)
  invitedBy  String   @map("invited_by") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([email])
  @@index([token])
  @@map("clinic_invitations")
}

// ============================================
// SUSCRIPCION: Plan de la Clinica
// ============================================

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  clinicId          String             @unique @map("clinic_id") @db.Uuid
  planType          PlanType           @map("plan_type")
  status            SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime          @map("current_period_start")
  currentPeriodEnd   DateTime          @map("current_period_end")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  cancelledAt       DateTime?          @map("cancelled_at")
  provider          String?            @db.VarChar(50)
  providerId        String?            @unique @map("provider_id") @db.VarChar(255)
  providerPriceId   String?            @map("provider_price_id") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([planType])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ============================================
// USUARIO (Auth propio con JWT + Refresh Token)
// El campo `role` es el rol global del usuario.
// Los roles por clinica se manejan en ClinicMember.role
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash")
  name          String    @db.VarChar(200)
  phone         String?   @db.VarChar(20)
  role          Role      @default(OWNER)
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships      ClinicMember[]
  ownedPets        Pet[]            @relation("OwnerPets")
  vetTreatments    Treatment[]      @relation("VetTreatments")
  refreshTokens    RefreshToken[]
  clinicalLogs     DailyLog[]       @relation("LogRegisteredBy")
  medicationLogs   MedicationLog[]  @relation("MedicationRegisteredBy")
  controlVisits    ControlVisit[]   @relation("ControlVisitVet")
  postOpProtocols  PostOpProtocol[] @relation("ProtocolCreatedBy")
  dischargeSheets  DischargeSheet[] @relation("DischargeCreatedBy")
  deviceTokens     DeviceToken[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// MASCOTA (perteneciente a un Tenant)
// ============================================

model Pet {
  id        String     @id @default(uuid()) @db.Uuid
  clinicId  String     @map("clinic_id") @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  name      String     @db.VarChar(100)
  species   PetSpecies
  breed     String?    @db.VarChar(100)
  weight    Decimal?   @db.Decimal(5, 2)
  birthDate DateTime?  @map("birth_date")
  color     String?    @db.VarChar(50)
  microchip String?    @db.VarChar(50)
  notes     String?    @db.Text
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  owner      User       @relation("OwnerPets", fields: [ownerId], references: [id], onDelete: Cascade)
  treatments Treatment[]

  @@index([clinicId])
  @@index([ownerId])
  @@index([species])
  @@index([name])
  @@unique([name, ownerId, clinicId], name: "pet_name_owner_clinic_unique")
  @@map("pets")
}

// ============================================
// TRATAMIENTO
// ============================================

model Treatment {
  id            String          @id @default(uuid()) @db.Uuid
  clinicId      String          @map("clinic_id") @db.Uuid
  vetId         String          @map("vet_id") @db.Uuid
  petId         String          @map("pet_id") @db.Uuid
  diagnosis     String          @db.Text
  notes         String?         @db.Text
  /// Tipo de procedimiento — define el protocolo y los signos a vigilar
  procedureType ProcedureType   @default(OTHER) @map("procedure_type")
  startDate     DateTime        @map("start_date")
  endDate       DateTime?       @map("end_date")
  status        TreatmentStatus @default(ACTIVE)
  priority      Int             @default(1) @db.SmallInt
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  vet            User             @relation("VetTreatments", fields: [vetId], references: [id], onDelete: Cascade)
  pet            Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  rules          TreatmentRule[]
  dailyLogs      DailyLog[]
  medicationLogs MedicationLog[]
  controlVisits  ControlVisit[]
  postOpProtocol PostOpProtocol?
  dischargeSheet DischargeSheet?

  @@index([clinicId])
  @@index([petId])
  @@index([vetId])
  @@index([status])
  @@index([procedureType])
  @@index([startDate])
  @@map("treatments")
}

// ============================================
// REGLAS DE TRATAMIENTO (medicamentos prescritos)
// ============================================

model TreatmentRule {
  id             String    @id @default(uuid()) @db.Uuid
  treatmentId    String    @map("treatment_id") @db.Uuid
  medicineName   String    @map("medicine_name") @db.VarChar(200)
  dosage         String    @db.VarChar(100)
  frequencyHours Int       @map("frequency_hours")
  requirePhoto   Boolean   @default(false) @map("require_photo")
  notes          String?   @db.Text
  startTime      DateTime? @map("start_time")  // Primera toma del día
  /// Fecha en que se dejó de usar esta regla (null = vigente)
  endDate        DateTime? @map("end_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  treatment      Treatment       @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  medicationLogs MedicationLog[]

  @@index([treatmentId])
  @@index([isActive])
  @@map("treatment_rules")
}

// ============================================
// LOGS DIARIOS DE EVOLUCIÓN GENERAL
// (observaciones del estado del paciente — no medicación)
// ============================================

model DailyLog {
  id             String       @id @default(uuid()) @db.Uuid
  treatmentId    String       @map("treatment_id") @db.Uuid
  /// Quién registró: OWNER desde casa, CLINICAL por vet en consulta, TECH por auxiliar
  logType        DailyLogType @default(OWNER) @map("log_type")
  /// Usuario que creó el log (puede ser el dueño o el veterinario)
  registeredById String       @map("registered_by_id") @db.Uuid
  registeredAt   DateTime     @default(now()) @map("registered_at")
  /// Ahora nullable: para logs de tipo CLINICAL puede no aplicar
  medicineTaken  Boolean?     @default(false) @map("medicine_taken")
  appetiteLevel  Int          @map("appetite_level") @db.SmallInt
  energyLevel    Int          @map("energy_level") @db.SmallInt
  painLevel      Int?         @map("pain_level") @db.SmallInt
  temperature    Decimal?     @db.Decimal(4, 1)
  alarmSigns     String?      @map("alarm_signs") @db.Text
  observations   String?      @db.Text
  imageUrl       String?      @map("image_url")
  vetNotes       String?      @map("vet_notes") @db.Text
  /// Historial de ediciones: JSON array de { editedAt, editedBy, previousValues }
  editHistory    Json?        @map("edit_history")
  editedAt       DateTime?    @map("edited_at")
  editedById     String?      @map("edited_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  treatment    Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  registeredBy User      @relation("LogRegisteredBy", fields: [registeredById], references: [id])

  @@index([treatmentId, registeredAt])
  @@index([registeredAt])
  @@index([logType])
  @@index([medicineTaken])
  @@map("daily_logs")
}

// ============================================
// REGISTRO DE MEDICACIÓN POR DOSIS INDIVIDUAL
// Cada evento de administración de un medicamento específico
// ============================================

model MedicationLog {
  id             String              @id @default(uuid()) @db.Uuid
  treatmentId    String              @map("treatment_id") @db.Uuid
  ruleId         String              @map("rule_id") @db.Uuid
  registeredById String              @map("registered_by_id") @db.Uuid
  /// Cuándo DEBÍA administrarse (calculado desde la regla)
  scheduledAt    DateTime            @map("scheduled_at")
  /// Cuándo SE ADMINISTRÓ realmente (null = no administrada aún)
  givenAt        DateTime?           @map("given_at")
  status         MedicationLogStatus @default(PENDING)
  /// Razón por la que se omitió o retrasó (requerida si status=SKIPPED)
  skippedReason  String?             @map("skipped_reason") @db.Text
  /// Foto de la administración (si la regla lo requiere)
  photoUrl       String?             @map("photo_url")
  notes          String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  treatment    Treatment     @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  rule         TreatmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  registeredBy User          @relation("MedicationRegisteredBy", fields: [registeredById], references: [id])

  @@index([treatmentId, scheduledAt])
  @@index([ruleId])
  @@index([status])
  @@index([scheduledAt])
  @@map("medication_logs")
}

// ============================================
// VISITAS DE CONTROL POST-OP
// Citas programadas de seguimiento
// ============================================

model ControlVisit {
  id          String             @id @default(uuid()) @db.Uuid
  treatmentId String             @map("treatment_id") @db.Uuid
  vetId       String?            @map("vet_id") @db.Uuid
  type        ControlVisitType
  status      ControlVisitStatus @default(SCHEDULED)
  scheduledAt DateTime           @map("scheduled_at")
  completedAt DateTime?          @map("completed_at")
  notes       String?            @db.Text
  /// Notas de la consulta (solo visibles al completar)
  clinicalFindings String?       @map("clinical_findings") @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  vet       User?     @relation("ControlVisitVet", fields: [vetId], references: [id])

  @@index([treatmentId])
  @@index([scheduledAt])
  @@index([status])
  @@map("control_visits")
}

// ============================================
// PROTOCOLO POST-OP
// Plantilla de signos de alarma y cuidados por tipo de cirugía
// ============================================

model PostOpProtocol {
  id            String        @id @default(uuid()) @db.Uuid
  treatmentId   String        @unique @map("treatment_id") @db.Uuid
  createdById   String        @map("created_by_id") @db.Uuid
  procedureType ProcedureType @map("procedure_type")
  /// JSON: Array de { sign: string, severity: 'CRITICAL'|'HIGH'|'MEDIUM', description: string }
  alarmSigns    Json          @map("alarm_signs")
  /// JSON: Array de string (restricciones: "No bañar por 10 días", "Mantener collar isabelino", etc.)
  restrictions  Json
  /// JSON: Array de string (cuidados especiales)
  specialCare   Json          @map("special_care")
  /// Cuándo llamar urgente a la clínica (texto libre del vet)
  emergencyCall String?       @map("emergency_call") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ProtocolCreatedBy", fields: [createdById], references: [id])

  @@index([treatmentId])
  @@index([procedureType])
  @@map("post_op_protocols")
}

// ============================================
// HOJA DE ALTA MÉDICA
// Instrucciones de alta generadas por el veterinario
// ============================================

model DischargeSheet {
  id           String   @id @default(uuid()) @db.Uuid
  treatmentId  String   @unique @map("treatment_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  /// Resumen del procedimiento / diagnóstico final
  summary      String   @db.Text
  /// Próximos pasos y citas recomendadas
  nextSteps    String?  @map("next_steps") @db.Text
  /// Señales de alarma para volver urgente
  returnSigns  String?  @map("return_signs") @db.Text
  /// Restricciones (no bañar, no correr, collar isabelino, etc.)
  restrictions String?  @db.Text
  /// JSON: Lista de medicamentos con horario exacto [{ name, dosage, schedule, duration }]
  medications  Json?
  /// Indicaciones de alimentación
  feedingNotes String?  @map("feeding_notes") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("DischargeCreatedBy", fields: [createdById], references: [id])

  @@index([treatmentId])
  @@map("discharge_sheets")
}

// ============================================
// DEVICE TOKEN — Notificaciones Push (Firebase FCM)
// ============================================

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(10)  // 'android' | 'ios' | 'web'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
  @@map("device_tokens")
}

// ============================================
// REFRESH TOKEN (Rotación segura de sesiones)
// ============================================

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}