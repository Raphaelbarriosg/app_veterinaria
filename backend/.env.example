# ============================================
# CONFIGURACIÓN DE DOCKER COMPOSE
# ============================================

# Nombre del proyecto Docker Compose
COMPOSE_PROJECT_NAME=veterinaria

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

# Entorno
NODE_ENV=development

# Puerto de la aplicación
PORT=3000
API_PORT=3000

# Logging
LOG_LEVEL=debug

# ============================================
# BASE DE DATOS POSTGRESQL
# ============================================

# Configuración local (sin Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veterinaria_db?schema=public"

# Configuración Docker Compose
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=veterinaria_db
DB_PORT=5432

# ============================================
# AUTENTICACIÓN JWT
# ============================================

JWT_SECRET="your-super-secure-jwt-secret-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# ============================================
# CLOUDINARY (SUBIDA DE IMÁGENES)
# ============================================

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# CORS (SEGURIDAD)
# ============================================

# Para desarrollo
CORS_ORIGIN="*"

# Para producción:
# CORS_ORIGIN="https://app.veterinaria.com,https://admin.veterinaria.com"

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS=900000      # 15 minutos
RATE_LIMIT_MAX_REQUESTS=100      # 100 requests por ventana

# ============================================
# REDIS (CACHE/SESIONES)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TTL=3600  # 1 hora en segundos

# ============================================
# PGADMIN (ADMINISTRACIÓN DE BD)
# ============================================

PGADMIN_EMAIL=admin@veterinaria.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ============================================
# TRAEFIK (REVERSE PROXY - OPCIONAL)
# ============================================

TRAEFIK_ACME_EMAIL=admin@veterinaria.com
API_DOMAIN=api.veterinaria.local

# ============================================
# MONITOREO
# ============================================

# Sentry (opcional)
SENTRY_DSN=""

# New Relic (opcional)
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_APP_NAME="veterinaria-api"

# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ============================================

# Para producción, usar:
# NODE_ENV=production
# DATABASE_URL="postgresql://user:password@host:5432/database?ssl=true&sslmode=require"
# JWT_SECRET="very-long-and-complex-secret-from-secrets-manager"
# CORS_ORIGIN="https://app.veterinaria.com"
# LOG_LEVEL=info

# ============================================
# VARIABLES ESPECÍFICAS DOCKER
# ============================================

# Health check
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# Memory limits
NODE_OPTIONS="--max-old-space-size=512"

# ============================================
# EMAIL (PARA FUTURAS FUNCIONALIDADES)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@veterinaria.com

# ============================================
# VARIABLES DE PRUEBA
# ============================================

# Usuarios de prueba (solo desarrollo)
TEST_VET_EMAIL=vet@test.com
TEST_VET_PASSWORD=vet123
TEST_OWNER_EMAIL=owner@test.com
TEST_OWNER_PASSWORD=owner123