# Variables de Entorno — Flutter (VetCare Mobile)
#
# Esta app usa `String.fromEnvironment` para configuracion en tiempo de compilacion.
# No uses paquetes .env en Flutter para produccion; usa --dart-define en su lugar.
#
# COMO USAR:
#
# Emulador Android:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1
#
# Dispositivo fisico en red local:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.X:3000/api/v1
#
# Produccion en la nube (Render):
#   flutter run --dart-define=API_BASE_URL=https://vetcare-backend-vxua.onrender.com/api/v1
#   flutter build apk --dart-define=API_BASE_URL=https://vetcare-backend-vxua.onrender.com/api/v1
#
# VARIABLES DISPONIBLES:
#
# URL base de la API REST del backend NestJS
API_BASE_URL=https://vetcare-backend-vxua.onrender.com/api/v1
